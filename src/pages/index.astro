---
import HomeLayout from '../layouts/HomeLayout.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const [latestPost] = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const nextSteps = [
  ...(latestPost
    ? [{ label: 'Latest post', title: latestPost.data.title, href: `/blog/${latestPost.id}/`, external: false }]
    : []),
  { label: 'YouTube', title: '@patrickarobinson', href: 'https://www.youtube.com/@patrickarobinson', external: true },
  { label: 'On PAR Dev', title: 'onpardev.com', href: 'https://onpardev.com', external: true },
  { label: 'Alamo Agents', title: 'alamoagents.org', href: 'https://alamoagents.org', external: true },
];
---

<HomeLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="bio-section">
          <h1 class="greeting">
            Hi, I'm <span class="name-highlight">Patrick Robinson</span>
          </h1>

          <p class="bio">
            A software engineer and AI enthusiast building agentic systems,
            multi-agent frameworks, and sharing discoveries from the frontier of
            AI-powered development.
          </p>

          <p class="bio-secondary">
            I'm deeply passionate about the convergence of AI and software
            engineering. How do we leverage LLMs and autonomous agents to 10x
            developer productivity? What does it look like to build AI-native
            applications that fundamentally change how we create software? How do we
            make sophisticated AI capabilities accessible to every developer?
          </p>

          <p class="bio-secondary">
            Currently exploring the cutting edge of agentic engineering, I
            specialize in building modern web applications while pioneering
            AI-assisted development tools. My work spans full-stack engineering,
            cloud infrastructure, and experimental multi-agent systems. I share
            insights across my projects, contribute to the AI development community,
            and actively engage with the emerging field of
            agentic coding where autonomous systems augment human creativity to
            build software that makes a meaningful difference.
          </p>
        </div>

        <div class="profile-section">
          <div class="profile-photo">
            <img src="/images/profile.jpg" alt="Patrick Robinson" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="next-steps" aria-labelledby="next-steps-heading">
    <div class="container">
      <h2 id="next-steps-heading" class="next-steps-heading">Next steps</h2>
      <ul class="next-steps-grid">
        {nextSteps.map((step) => (
          <li>
            <a
              href={step.href}
              class="next-step"
              {...(step.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="next-step-label">{step.label}</span>
              <span class="next-step-title">{step.title}</span>
              <span class="next-step-arrow" aria-hidden="true">{step.external ? '↗' : '→'}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</HomeLayout>

<style>
  .hero-section {
    display: flex;
    align-items: center;
    padding: 4rem 0 3rem;
    background: white;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .bio-section {
    max-width: 600px;
  }

  .greeting {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: normal;
    color: #333;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }

  .name-highlight {
    color: #4299E1;
    font-weight: 600;
  }

  .bio {
    font-size: 1.25rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .bio-secondary {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .profile-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .profile-photo {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .profile-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  .next-steps {
    padding: 1rem 0 2rem;
  }

  .next-steps-heading {
    font-size: 1.5rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 1.25rem;
  }

  .next-steps-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .next-steps-grid li {
    display: flex;
  }

  .next-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
    padding: 1.25rem 2.5rem 1.25rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 12px);
    background: var(--color-bg-secondary);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .next-step:hover,
  .next-step:focus-visible {
    border-color: #4299E1;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(66, 153, 225, 0.2);
  }

  .next-step-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #2b6cb0;
  }

  .next-step-title {
    font-size: 1rem;
    font-weight: 500;
    color: #1a202c;
    line-height: 1.4;
  }

  .next-step-arrow {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    color: #2b6cb0;
  }

  @media (max-width: 1024px) {
    .next-steps-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 2rem 0;
    }

    .next-steps-grid {
      grid-template-columns: 1fr;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .bio-section {
      max-width: 100%;
    }

    .greeting {
      font-size: 2rem;
    }

    .bio {
      font-size: 1.125rem;
    }

    .container {
      padding: 0 1rem;
    }

    .profile-photo {
      width: 200px;
      height: 200px;
    }
  }
</style>
