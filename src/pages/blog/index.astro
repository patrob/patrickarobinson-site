---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticlesList from '../../components/ArticlesList.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pageTitle = `Blog - ${SITE_TITLE}`;
const pageDescription = 'Articles about web development, technology, and software engineering insights.';
---

<Layout title={pageTitle} description={pageDescription}>
	<main class="main-content">
		<div class="container blog-container">
			<div class="blog-header text-center">
				<h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Blog</h1>
				<p class="text-lg text-gray-600 max-w-2xl mx-auto">
					Thoughts on web development, technology trends, and lessons learned from building modern applications.
				</p>
			</div>

			<ArticlesList articles={posts} showExcerpts={true} columns={2} />
		</div>
	</main>
</Layout>

<style>
	.blog-container {
		padding-block: var(--space-12) var(--space-16);
	}

	.blog-header {
		margin-bottom: var(--space-12);
	}

	.blog-header h1 {
		font-size: var(--font-size-4xl);
		margin-bottom: var(--space-4);
	}

	.blog-header p {
		max-width: 42rem;
		margin-inline: auto;
	}

	.text-gray-900 {
		color: var(--color-text-primary);
	}

	.text-gray-600 {
		color: var(--color-text-secondary);
	}
</style>
